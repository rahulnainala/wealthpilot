# WealthPilot backend configuration.
# Copy to `.env` and fill in real values. Defaults keep the app in mock mode.

# --- Zerodha Kite Connect ---
# From https://developers.kite.trade/ (a Kite Connect app).
KITE_API_KEY=your-kite-api-key
KITE_API_SECRET=your-kite-api-secret
# Must match the redirect URL registered on your Kite Connect app.
KITE_REDIRECT_URL=http://localhost:3001/auth/kite/callback

# When true, all data comes from the in-memory fixture portfolio — no Kite
# session or credentials required. Set to false for live Zerodha data.
USE_MOCK_KITE=true

# --- Security ---
# Fernet key encrypting the Kite access token at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://wealthpilot:wealthpilot@localhost:5432/wealthpilot

# --- Risk engine (gRPC, internal-only) ---
RISK_ENGINE_HOST=localhost
RISK_ENGINE_PORT=50051
SIMULATION_PATHS=10000

# --- HTTP / CORS ---
FRONTEND_ORIGIN=http://localhost:3001

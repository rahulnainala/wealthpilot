# WealthPilot frontend configuration.
# Copy to `.env.local` for local development.

# Backend base URL. REST calls hit `${NEXT_PUBLIC_API_BASE_URL}/api/...`, and the
# WebSocket URL is derived from it (http -> ws). In production point this at your
# backend, e.g. https://api.yourdomain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
